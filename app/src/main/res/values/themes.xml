<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shared: Material DayNight + app colors (status bar flag in Theme.MapControl) -->
    <style name="Theme.MapControl.Base" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/backgroundColor</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>

        <item name="android:statusBarColor">@color/backgroundColor</item>
        <item name="android:navigationBarColor">@color/backgroundColor</item>

        <item name="colorPrimary">@color/primaryColor</item>
        <item name="colorPrimaryDark">@color/primaryDarkColor</item>
        <item name="colorAccent">@color/accentColor</item>

        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>

        <item name="alertDialogTheme">@style/CustomAlertDialog</item>
        <item name="android:alertDialogTheme">@style/CustomAlertDialog</item>
    </style>

    <!-- Light UI: dark icons in status bar -->
    <style name="Theme.MapControl" parent="Theme.MapControl.Base">
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Dedicated dark report surface for the drive score screen. -->
    <style name="Theme.MapControl.Driving" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">#080A0A</item>
        <item name="android:statusBarColor">#080A0A</item>
        <item name="android:navigationBarColor">#080A0A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorBackground">#080A0A</item>
        <item name="android:textColorPrimary">#F4F7F7</item>
        <item name="colorAccent">#FFB000</item>
    </style>

    <!-- Terminal CLI skin: dark-only, phosphor green, monospace, square panes. -->
    <style name="Theme.MapControl.Cyber" parent="Theme.MapControl">
        <item name="android:windowBackground">#0A0A0A</item>
        <item name="android:colorBackground">#0A0A0A</item>
        <item name="android:statusBarColor">#0A0A0A</item>
        <item name="android:navigationBarColor">#0A0A0A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColorPrimary">#33FF00</item>
        <item name="android:textColorSecondary">#1F9A1F</item>
        <item name="android:textColorHint">#1F7A1F</item>
        <item name="colorPrimary">#33FF00</item>
        <item name="colorPrimaryDark">#0A0A0A</item>
        <item name="colorAccent">#33FF00</item>
        <item name="alertDialogTheme">@style/CustomAlertDialogCyber</item>
        <item name="android:alertDialogTheme">@style/CustomAlertDialogCyber</item>
    </style>

    <style name="CustomAlertDialogCyber" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="android:windowBackground">#0A0A0A</item>
        <item name="android:background">#0A0A0A</item>
        <item name="android:colorBackground">#0A0A0A</item>
        <item name="android:textColorPrimary">#33FF00</item>
        <item name="android:textColorSecondary">#1F9A1F</item>
        <item name="colorAccent">#33FF00</item>
        <item name="buttonBarPositiveButtonStyle">@style/CustomAlertDialogButtonCyber</item>
        <item name="buttonBarNegativeButtonStyle">@style/CustomAlertDialogButtonCyber</item>
        <item name="buttonBarNeutralButtonStyle">@style/CustomAlertDialogButtonCyber</item>
        <item name="android:buttonBarButtonStyle">@style/CustomAlertDialogButtonCyber</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/CustomAlertDialogButtonCyber</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/CustomAlertDialogButtonCyber</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/CustomAlertDialogButtonCyber</item>
    </style>

    <style name="CustomAlertDialogButtonCyber" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#33FF00</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Cold start: process window siyah olmasın; MainActivity sonra Theme.MapControl'e geçer -->
    <style name="Theme.MapControl.Splash" parent="Theme.MapControl">
        <item name="android:windowBackground">@drawable/bg_launch_splash</item>
        <item name="android:statusBarColor">@color/boot_splash_gradient_mid</item>
        <item name="android:navigationBarColor">@color/boot_splash_gradient_mid</item>
        <item name="android:windowFullscreen">false</item>
    </style>

    <!-- Legacy name: follows system day/night via Theme.MapControl parent -->
    <style name="Theme.AppCompat.Light.NoActionBar" parent="Theme.MapControl" />

    <style name="CustomAlertDialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@color/surfaceColor</item>
        <item name="android:background">@color/surfaceColor</item>
        <item name="colorAccent">@color/accentColor</item>
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>
        <item name="buttonBarPositiveButtonStyle">@style/CustomAlertDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/CustomAlertDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/CustomAlertDialogButton</item>
        <item name="android:buttonBarButtonStyle">@style/CustomAlertDialogButton</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/CustomAlertDialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/CustomAlertDialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/CustomAlertDialogButton</item>
        <item name="android:colorBackground">@color/surfaceColor</item>
    </style>

    <style name="CustomAlertDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/accentColor</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
