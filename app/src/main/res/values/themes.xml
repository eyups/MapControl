<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shared: Material DayNight + app colors (status bar flag in Theme.MapControl) -->
    <style name="Theme.MapControl.Base" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/ck_bg_base</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:fontFamily">@font/inter</item>

        <item name="android:statusBarColor">@color/ck_bg_base</item>
        <item name="android:navigationBarColor">@color/ck_bg_base</item>

        <item name="colorPrimary">@color/primaryColor</item>
        <item name="colorPrimaryDark">@color/primaryDarkColor</item>
        <item name="colorAccent">@color/accentColor</item>

        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>

        <item name="alertDialogTheme">@style/CustomAlertDialog</item>
        <item name="android:alertDialogTheme">@style/CustomAlertDialog</item>
    </style>

    <!-- Light UI: dark icons in status bar -->
    <style name="Theme.MapControl" parent="Theme.MapControl.Base">
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Dedicated dark report surface for the drive score screen. -->
    <style name="Theme.MapControl.Driving" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/ck_bg_base</item>
        <item name="android:statusBarColor">@color/ck_bg_base</item>
        <item name="android:navigationBarColor">@color/ck_bg_base</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorBackground">@color/ck_bg_base</item>
        <item name="android:textColorPrimary">@color/ck_text_high</item>
        <item name="colorAccent">@color/ck_accent</item>
    </style>

    <!-- Cold start: process window siyah olmasın; MainActivity sonra Theme.MapControl'e geçer -->
    <style name="Theme.MapControl.Splash" parent="Theme.MapControl">
        <item name="android:windowBackground">@drawable/bg_launch_splash</item>
        <item name="android:statusBarColor">@color/boot_splash_gradient_mid</item>
        <item name="android:navigationBarColor">@color/boot_splash_gradient_mid</item>
        <item name="android:windowFullscreen">false</item>
    </style>

    <style name="CustomAlertDialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@color/surfaceColor</item>
        <item name="android:background">@color/surfaceColor</item>
        <item name="colorAccent">@color/ck_accent</item>
        <item name="android:colorAccent">@color/ck_accent</item>
        <item name="colorPrimary">@color/ck_accent</item>
        <item name="colorPrimaryVariant">@color/ck_accent_active</item>
        <item name="colorOnPrimary">@color/ck_on_accent</item>
        <item name="colorSecondary">@color/ck_accent</item>
        <item name="colorOnSecondary">@color/ck_on_accent</item>
        <item name="android:textColorPrimary">@color/ck_text_high</item>
        <item name="android:textColorSecondary">@color/ck_text_medium</item>
        <item name="buttonBarPositiveButtonStyle">@style/CustomAlertDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/CustomAlertDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/CustomAlertDialogButton</item>
        <item name="android:buttonBarButtonStyle">@style/CustomAlertDialogButton</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/CustomAlertDialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/CustomAlertDialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/CustomAlertDialogButton</item>
        <item name="android:colorBackground">@color/surfaceColor</item>
    </style>

    <style name="CustomAlertDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/ck_accent</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Cockpit typography roles (F1) -->
    <style name="TextAppearance.Cockpit" parent="android:TextAppearance.Material.Body1">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/ck_text_high</item>
    </style>

    <style name="TextAppearance.Cockpit.Display">
        <item name="android:textSize">48sp</item>
        <item name="android:lineHeight">56sp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/ck_text_high</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Cockpit.HeadlineLg">
        <item name="android:textSize">36sp</item>
        <item name="android:lineHeight">44sp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/ck_text_high</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Cockpit.HeadlineMd">
        <item name="android:textSize">28sp</item>
        <item name="android:lineHeight">36sp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textColor">@color/ck_text_high</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Cockpit.HeadlineSm">
        <item name="android:textSize">22sp</item>
        <item name="android:lineHeight">28sp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textColor">@color/ck_text_high</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Cockpit.Title">
        <item name="android:textSize">18sp</item>
        <item name="android:lineHeight">24sp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textColor">@color/ck_text_high</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Cockpit.BodyLg">
        <item name="android:textSize">18sp</item>
        <item name="android:lineHeight">26sp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textColor">@color/ck_text_high</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Cockpit.BodyMd">
        <item name="android:textSize">16sp</item>
        <item name="android:lineHeight">24sp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textColor">@color/ck_text_high</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Cockpit.BodySm">
        <item name="android:textSize">15sp</item>
        <item name="android:lineHeight">20sp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textColor">@color/ck_text_medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Cockpit.LabelCaps">
        <item name="android:textSize">13sp</item>
        <item name="android:lineHeight">16sp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/ck_text_medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Cockpit.Mono">
        <item name="android:textSize">15sp</item>
        <item name="android:lineHeight">20sp</item>
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textColor">@color/ck_text_medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>
