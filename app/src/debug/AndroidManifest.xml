<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- Debug-only gallery; release manifest keeps exported=false. -->
        <activity
            android:name=".ui.cockpit.CockpitGalleryActivity"
            android:exported="true"
            tools:replace="android:exported" />

        <!-- Debug-only: adb ile flavor TTS testi. -->
        <receiver
            android:name=".tts.TtsTestReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.eyups.roaddeck.TEST_TTS" />
            </intent-filter>
        </receiver>
    </application>
    <queries>
        <package android:name="com.desaysv.ivi.vds.carinfo" />
        <package android:name="com.desaysv.ivi.vds.sms" />
        <package android:name="com.desaysv.ivi.vds.carlan" />
        <package android:name="com.desaysv.ivi.vds.carstate" />
        <package android:name="com.desaysv.ivi.vds.setting" />
    </queries>
</manifest>
